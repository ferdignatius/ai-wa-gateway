# Hermes is enabled by default
HERMES_ENABLED=true
HERMES_URL=http://host.docker.internal:3000/api/profiles/ferdinand_assistant/message
HERMES_TOKEN=replace-with-hermes-token

# Set HERMES_ENABLED=false to use n8n or another generic HTTP backend
BACKEND_URL=http://host.docker.internal:3000/webhook/whatsapp
BACKEND_TOKEN=replace-with-backend-token
ALLOW_PRIVATE_BACKEND=true
PORT=3001
DISCONNECT_EXIT_MS=60000
